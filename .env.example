# DataForge environment configuration
# Copy to .env and adjust. NEVER commit .env.

# --- PostgreSQL (analytics warehouse) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=change-me

# --- Data lake root (bronze/silver/gold/quarantine live under here) ---
DATAFORGE_DATA_DIR=./data

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
# Optional: short, space-free scratch dir used for Spark/JVM temp files (matters on Windows)
SPARK_TMP_DIR=

# --- Reference data API (SOURCE 5). file:// reads generated mock responses, http:// hits the mock server ---
REFERENCE_API_URL=file://./data/raw/api

# --- Synthetic data generation ---
DATAFORGE_SEED=20240101
DATAFORGE_SCALE=1.0

# --- API / dashboard ---
API_PORT=8000
DASHBOARD_PORT=8501

# --- dbt ---
DBT_TARGET=dev

# --- Airflow (docker only) ---
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=generate-with-python-c-from-cryptography.fernet-import-Fernet-print-Fernet.generate_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
